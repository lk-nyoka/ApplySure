# Copy to .env and replace placeholders. Never commit the real file.
SUPABASE_URL=https://your-project.supabase.co
CORS_ORIGINS=http://localhost:5173

# Document uploads (POST /api/checks). Files are read in memory and never stored.
# Uploads are refused unless a ClamAV daemon is set, or unscanned uploads are allowed for local development.
CLAMAV_HOST=
CLAMAV_PORT=3310
ALLOW_UNSCANNED_UPLOADS=false
MAX_UPLOAD_MB=10
PDF_TIMEOUT_SECONDS=15
OCR_TIMEOUT_SECONDS=90

# "production" hides the API docs and refuses to start with ALLOW_UNSCANNED_UPLOADS=true.
ENVIRONMENT=development
API_REQUESTS_PER_MINUTE=240

# Free-tier AI for bursary ingestion (python -m app.ingest). Set at least one; tried in this order.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CURSOR_API_KEY=
BAZAARLINK_API_KEY=
FREEAIAPIKEY_API_KEY=
ORCAROUTER_API_KEY=
REQUESTY_API_KEY=

